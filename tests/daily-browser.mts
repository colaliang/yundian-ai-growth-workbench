import fs from 'node:fs';import os from 'node:os';import path from 'node:path';import assert from 'node:assert/strict';import {createRequire} from 'node:module';import {FileWorkspace,createServer} from '../server.ts';
const require=createRequire(import.meta.url);const {chromium}=require(process.env.PLAYWRIGHT_MODULE_PATH||'playwright');
const root=fs.mkdtempSync(path.join(os.tmpdir(),'daily-browser-'));const store=new FileWorkspace(root);const server=createServer(store,8879);let browser;
try{await new Promise(r=>server.listen(8879,'127.0.0.1',r));browser=await chromium.launch({headless:true});const context=await browser.newContext({permissions:['clipboard-read','clipboard-write']});const page=await context.newPage();const errors=[];page.on('pageerror',e=>errors.push(e.message));await page.goto('http://127.0.0.1:8879');await page.getByRole('heading',{name:'今日建议',exact:true}).waitFor();await page.locator('[data-action=daily-ignore]').click();await page.getByText('当前没有可推荐工作。',{exact:false}).waitFor();await page.reload();await page.getByText('当前没有可推荐工作。',{exact:false}).waitFor();
const save=(action,payload)=>store.save({action,payload,revision:store.load().revision});save('profile',{company:'测试企业',products:'产品',markets:'美国',persona:'采购',goal:'获客'});save('feedback',{leadId:'L1',source:'实际电话',cycleId:'cycle-1',result:'拒绝',reason:'交期',next:'核验交期'});await page.reload();await page.locator('[data-action=daily-defer]').click();await page.getByText('当前没有可推荐工作。',{exact:false}).waitFor();const file=store.files('daily-decisions','.json').find(f=>store.json(f).status==='deferred');store.put(file,{...store.json(file),until:'2000-01-01'});await page.reload();await page.locator('[data-action=daily-create]').evaluate(el=>el.dataset.id='invalid');await page.locator('[data-action=daily-create]').click();await page.getByText('建议已变化，请刷新后重试',{exact:true}).waitFor();assert.equal(store.load().tasks.length,0);await page.reload();await page.locator('[data-action=daily-create]').click();await page.locator('[data-action=copy]').first().waitFor();await page.locator('[data-action=copy]').first().click();await page.waitForTimeout(150);const copied=await page.evaluate(()=>navigator.clipboard.readText());assert.ok(copied.includes(store.load().tasks[0].id));assert.equal(store.load().tasks[0].status,'ready');assert.equal(store.load().tasks.length,1);await page.setViewportSize({width:390,height:844});await page.reload();await page.getByRole('heading',{name:'今日建议',exact:true}).waitFor();assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth),false);assert.deepEqual(errors,[]);console.log('Browser PASS: persisted ignore, defer, real task create, actual clipboard task ID, ready status, 390px no overflow, no page errors');
}finally{await browser?.close();await new Promise(r=>server.close(r));fs.rmSync(root,{recursive:true,force:true});}

