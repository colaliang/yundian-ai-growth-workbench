import fs from 'node:fs';import os from 'node:os';import path from 'node:path';import assert from 'node:assert/strict';import {createRequire} from 'node:module';import {FileWorkspace,createServer} from '../server.ts';
const require=createRequire(import.meta.url);const {chromium}=require(process.env.PLAYWRIGHT_MODULE_PATH||'playwright');
const root=fs.mkdtempSync(path.join(os.tmpdir(),'schedule-browser-'));const store=new FileWorkspace(root);const server=createServer(store,8886);let browser;
try{await new Promise(r=>server.listen(8886,'127.0.0.1',r));browser=await chromium.launch({headless:true});const context=await browser.newContext({permissions:['clipboard-read','clipboard-write']});const page=await context.newPage();const errors=[];page.on('pageerror',e=>errors.push(e.message));await page.goto('http://127.0.0.1:8886');await page.getByRole('heading',{name:'定时任务',exact:true}).waitFor();await page.locator('[data-action=nav][data-id=schedules]').last().click();await page.getByRole('heading',{name:'定时任务',exact:true}).waitFor();await page.locator('[data-action=schedule-create]').click();await page.locator('dialog [name=name]').fill('浏览器每日计划');await page.locator('dialog [name=timezone]').fill('invalid-zone');await page.locator('dialog button[type=submit]').click();await page.locator('dialog .error').filter({hasText:/Invalid time zone/}).waitFor();assert.equal(store.load().schedules.length,0);await page.locator('dialog [name=timezone]').fill('Asia/Shanghai');await page.locator('dialog button[type=submit]').click();await page.getByRole('heading',{name:'浏览器每日计划',exact:true}).waitFor();const s=store.load().schedules[0];assert.equal(s.time,'09:00');assert.equal(s.status,'unsupported');await page.reload();await page.getByRole('heading',{name:'浏览器每日计划',exact:true}).waitFor();await page.locator('[data-action=schedule-copy]').click();await page.waitForTimeout(200);const copied=await page.evaluate(()=>navigator.clipboard.readText());assert.ok(copied.includes(s.id));assert.ok(copied.includes('Asia/Shanghai'));assert.ok(copied.includes('schedule-receipt'));await page.locator('[data-action=schedule-receipt]').click();await page.locator('dialog [name=hostTaskId]').fill('claimed-host-id');await page.locator('dialog [name=source]').fill('客户宿主导出');await page.locator('dialog [name=evidence]').fill('宿主创建回执待验证');await page.locator('dialog button[type=submit]').click();await page.getByText('等待宿主验证',{exact:true}).waitFor();assert.equal(store.load().schedules[0].receiptVerified,false);await page.locator('[data-action=schedule-pause]').click();await page.getByText('等待宿主暂停',{exact:true}).waitFor();await page.reload();await page.getByText('等待宿主暂停',{exact:true}).waitFor();await page.setViewportSize({width:390,height:844});await page.reload();await page.getByRole('heading',{name:'定时任务',exact:true}).waitFor();assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth),false);assert.deepEqual(errors,[]);console.log('PASS browser: actual config save/restart, invalid zone error, copied schedule ID and CLI, receipt pending, pause pending/restart, 390px no overflow, zero page errors');}
finally{await browser?.close();await new Promise(r=>server.close(()=>r()));fs.rmSync(root,{recursive:true,force:true});}
